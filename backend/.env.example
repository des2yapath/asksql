[TEMPLATE]
# Copy this to .env for local development. On Render, set these as
# environment variables in the dashboard instead - don't upload .env there.

ENVIRONMENT=development

# --- Database ---------------------------------------------------------
# Use Neon's POOLED connection string (hostname contains "-pooler").
# Dashboard -> your project -> Connection Details -> "Pooled connection".
# Format: postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://app_readonly:change-me@ep-example-pooler.us-east-1.aws.neon.tech/asksql?sslmode=require
DB_SCHEMA=public
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
QUERY_TIMEOUT_MS=8000

# --- GenAI (Google Gemini) ----------------------------------------------
# Free key, no credit card: https://aistudio.google.com/apikey
# (keys look like AIza...)
GEMINI_API_KEY=your_gemini_api_key_here
# Flash-tier model. gemini-2.5-flash is free-tier eligible. Newer Flash
# models such as gemini-3.8-flash also work, but they always reason before
# answering, so expect noticeably higher latency per question.
GEMINI_MODEL=gemini-2.5-flash
# Gemini's thinking models can be slower than a plain completion - raise this
# if you see timeout errors under load.
LLM_TIMEOUT_SECONDS=20

# --- Guardrails ---------------------------------------------------------
MAX_RESULT_ROWS=200

# --- Schema cache ---------------------------------------------------------
SCHEMA_CACHE_TTL_SECONDS=300

# --- CORS ---------------------------------------------------------------
# Comma-separated. Add your deployed Vercel URL alongside localhost.
ALLOWED_ORIGINS=http://localhost:5173,https://your-app.vercel.app
